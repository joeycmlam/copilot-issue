# =============================================================================
# Copilot Issue Assignment API v2 — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. The service reads them via
# pydantic-settings (see app/config.py).
# =============================================================================

# Required. Personal Access Token (classic) or fine-grained PAT.
# Required scopes:
#   - repo                 (create issues, assign copilot-swe-agent[bot])
#   - read:org             (read agent files in <org>/.github-private)
#   - admin:enterprise     (read enterprise-level agents — only if used)
# The token must belong to a user who has Copilot coding agent access on the
# target repository. GITHUB_TOKEN from a workflow does NOT work.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional. Override the GitHub API base URL for GHES.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_GRAPHQL_URL=https://github.example.com/api/graphql

# Optional. The login of the bot that performs Copilot work. Default is
# copilot-swe-agent[bot]. Override only if GitHub renames the bot.
COPILOT_BOT_LOGIN=copilot-swe-agent[bot]

# Optional. Default base branch when none is supplied in the request.
DEFAULT_BASE_BRANCH=main

# Optional. Enterprise slug used by the /agents/enterprise/{ent} endpoint
# when the caller does not pass one. Leave blank if you don't use enterprise
# agents.
DEFAULT_ENTERPRISE=

# Optional. HTTP request timeout in seconds.
HTTP_TIMEOUT_SECONDS=30

# Optional. Service log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
